<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LibreMed.ViewModels"
        x:Class="LibreMed.Views.VisitsWindow"
        x:DataType="vm:VisitsWindowViewModel"
        Width="750" Height="650"
        Title="{Binding WindowTitle}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="12">
        <Border Padding="10" CornerRadius="8" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="4">
                    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subheader}" Opacity="0.7"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="All visits" FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Visits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WhenText}" FontWeight="SemiBold"/>
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Content="Diagnosis"
                                                Command="{Binding OpenDiagnosisCommand}"
                                                CommandParameter="{Binding Id}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Reason}" Opacity="0.85"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Notes}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="10" CornerRadius="8" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="New visit"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Date"/>
                <DatePicker Grid.Row="1" Grid.Column="1"
                            SelectedDate="{Binding NewVisitDate}"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Top"
                           Text="Reason / notes"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
                    <TextBox Watermark="Reason (required)"
                             Text="{Binding NewVisitReason}"/>

                    <TextBox Watermark="Notes (optional)"
                             Text="{Binding NewVisitNotes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Add visit"
                                Command="{Binding AddVisitCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>