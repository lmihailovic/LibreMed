<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LibreMed.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="LibreMed.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LibreMed">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <TabControl Margin="12">

        <TabItem Header="Patients">
            <Grid RowDefinitions="Auto,*" ColumnDefinitions="320,*" RowSpacing="12" ColumnSpacing="12">
                <TextBlock Grid.ColumnSpan="2"
                           Margin="0 10 0 0"
                           Text="Patients"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <!-- Left: Patient list + Create patient -->
                <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">

                    <Border Padding="10" CornerRadius="8" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <DockPanel>
                                <TextBlock Text="All patients" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Patients}"
                                     SelectedItem="{Binding SelectedPatient}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding BirthDateText}" Opacity="0.7" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              RowSpacing="8"
                              ColumnSpacing="8">

                            <TextBlock Grid.ColumnSpan="2" Text="Create new patient" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding NewPatientName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Surname" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding NewPatientSurname}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Birth date" VerticalAlignment="Center"/>
                            <DatePicker MinWidth="0" Width="*" Grid.Row="3" Grid.Column="1" SelectedDate="{Binding NewPatientBirthDate}"/>

                            <Button Grid.Row="4" Grid.ColumnSpan="2"
                                    Content="Create patient"
                                    Command="{Binding CreatePatientCommand}"/>

                            <Button Grid.Row="5" Grid.ColumnSpan="2"
                                    Content="Open selected profile"
                                    Command="{Binding OpenSelectedPatientProfileCommand}"
                                    IsEnabled="{Binding HasSelectedPatient}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right: Selected patient upcoming visits -->
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">

                    <Border Padding="10" CornerRadius="8" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedPatientHeader}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPatientSubheader}" Opacity="0.7"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <TextBlock Text="Upcoming visits (selected patient)" FontWeight="SemiBold"/>

                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding UpcomingVisits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Reason}" Opacity="0.85"/>
                                                    <TextBlock Text="{Binding Notes}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Schedule">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <DockPanel>
                    <TextBlock Text="Upcoming visits (all patients)" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <Button Content="Refresh" Command="{Binding RefreshScheduleCommand}" DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding UpcomingVisitsAll}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WhenText}" FontWeight="SemiBold"/>
                                                <Button Grid.Row="0" Grid.Column="1"
                                                        Content="Open profile"
                                                        Command="{Binding OpenProfileCommand}"
                                                        CommandParameter="{Binding PatientId}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PatientFullName}" Opacity="0.9"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Reason}" Opacity="0.85"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
