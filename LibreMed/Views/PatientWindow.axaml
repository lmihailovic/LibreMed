<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LibreMed.ViewModels"
        x:Class="LibreMed.Views.PatientWindow"
        x:DataType="vm:PatientWindowViewModel"
        Width="600" Height="700"
        Title="{Binding WindowTitle}">

    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="12">
        <Border Padding="10" CornerRadius="8" BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Subheader}" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="8" ColumnSpacing="10">

                    <TextBlock Grid.ColumnSpan="2" Text="Patient details" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Id" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding PatientIdText}" IsReadOnly="True"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Name" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding NameText}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Surname" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding SurnameText}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Birth date" Opacity="0.7" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding BirthDate}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Phone number" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding PhoneNumberText}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Email" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding EmailText}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="General notes" Opacity="0.7" VerticalAlignment="Top"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding GeneralNotesText}" AcceptsReturn="True" Height="60"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Medical history" Opacity="0.7" VerticalAlignment="Top"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding MedicalHistoryText}" AcceptsReturn="True" Height="60"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Family history" Opacity="0.7" VerticalAlignment="Top"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Text="{Binding FamilyHistoryText}" AcceptsReturn="True" Height="60"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Medications" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding MedicationsText}"
                               Watermark="Comma-separated (e.g. Ibuprofen, Vitamin D)"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Allergies" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding AllergiesText}" Watermark="Comma-separated"/>

                    <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Save patient" Command="{Binding SavePatientCommand}"/>
                        <Button Content="Open visits" Command="{Binding OpenVisitsCommand}"/>
                        <Button Content="Delete patient" Command="{Binding DeletePatientCommand}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
